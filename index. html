    <style>
        body {
            background-color: #05060A;
            color: #F3F4F6;
            font-family: 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
        }

        .gold-gradient-text {
            background: linear-gradient(135deg, #FFF0B3 0%, #D4AF37 50%, #997A15 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .gold-border-card {
            border: 1px solid rgba(212, 175, 55, 0.25);
            background: rgba(17, 20, 32, 0.75);
            backdrop-filter: blur(16px);
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .gold-border-card:hover {
            border-color: rgba(212, 175, 55, 0.8);
            box-shadow: 0 10px 30px rgba(212, 175, 55, 0.2), 0 0 15px rgba(212, 175, 55, 0.3);
            transform: translateY(-4px);
        }

        .btn-gold-royal {
            background: linear-gradient(135deg, #D4AF37 0%, #AA8518 100%);
            color: #05060A;
            font-weight: 700;
            transition: all 0.3s ease;
            box-shadow: 0 4px 20px rgba(212, 175, 55, 0.3);
        }

        .btn-gold-royal:hover {
            background: linear-gradient(135deg, #F2CA52 0%, #D4AF37 100%);
            box-shadow: 0 6px 25px rgba(212, 175, 55, 0.5);
