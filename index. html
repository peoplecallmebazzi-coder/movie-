        <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[550px] h-[550px] bg-gold-500/10 rounded-full blur-[120px] pointer-events-none"></div>

        <div class="relative z-10 max-w-4xl mx-auto text-center space-y-6">
            <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-300 text-xs font-semibold tracking-wider uppercase backdrop-blur-md">
