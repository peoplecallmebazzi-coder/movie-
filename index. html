            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #05060A;
        }
        ::-webkit-scrollbar-thumb {
            background: #181C2B;
            border-radius: 4px;
            border: 1px solid rgba(212, 175, 55, 0.2);
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #D4AF37;
        }
