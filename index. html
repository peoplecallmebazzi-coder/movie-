        function changeLanguage(langKey) {
            const data = i18n[langKey] || i18n['en'];
            
            // Text Replacements
            document.getElementById('heroBadge').innerText = data.heroBadge;
            document.getElementById('heroTitleMain').innerText = data.heroTitleMain;
            document.getElementById('heroTitleSub').innerText = data.heroTitleSub;
            document.getElementById('heroDesc').innerText = data.heroDesc;
            
            document.getElementById('chipCinemas').innerText = data.chipCinemas;
            document.getElementById('chipEvents').innerText = data.chipEvents;
            document.getElementById('chipDining').innerText = data.chipDining;

            document.getElementById('cinemasCategory').innerText = data.cinemasCategory;
            document.getElementById('cinemasTitle').innerText = data.cinemasTitle;
            document.getElementById('cinemasSub').innerText = data.cinemasSub;

            document.getElementById('btnVox').innerText = data.btnVox;
            document.getElementById('btnCinepolis').innerText = data.btnCinepolis;
            document.getElementById('btnNovo').innerText = data.btnNovo;
            document.getElementById('btnBahja').innerText = data.btnBahja;

            document.getElementById('descVox').innerText = data.descVox;
            document.getElementById('descCinepolis').innerText = data.descCinepolis;
            document.getElementById('descNovo').innerText = data.descNovo;
            document.getElementById('descBahja').innerText = data.descBahja;

            document.getElementById('eventsCategory').innerText = data.eventsCategory;
            document.getElementById('eventsTitle').innerText = data.eventsTitle;
            document.getElementById('btnSadya').innerText = data.btnSadya;
            document.getElementById('btnConcert').innerText = data.btnConcert;
            document.getElementById('descSadya').innerText = data.descSadya;
            document.getElementById('descConcert').innerText = data.descConcert;

            document.getElementById('luxuryCategory').innerText = data.luxuryCategory;
            document.getElementById('luxuryTitle').innerText = data.luxuryTitle;
            document.getElementById('descOpera').innerText = data.descOpera;
            document.getElementById('descBustan').innerText = data.descBustan;
            document.getElementById('descOmanAir').innerText = data.descOmanAir;

            // RTL Handling for Arabic and Urdu
            if (langKey === 'ar' || langKey === 'ur') {
                document.documentElement.setAttribute('dir', 'rtl');
                document.body.className = (langKey === 'ar') ? 'font-arabic selection:bg-gold-500 selection:text-obsidian-950' : 'font-urdu selection:bg-gold-500 selection:text-obsidian-950';
            } else {
                document.documentElement.setAttribute('dir', 'ltr');
                if (langKey === 'ml') document.body.className = 'font-malayalam selection:bg-gold-500 selection:text-obsidian-950';
                else if (langKey === 'hi') document.body.className = 'font-hindi selection:bg-gold-500 selection:text-obsidian-950';
                else if (langKey === 'ta') document.body.className = 'font-tamil selection:bg-gold-500 selection:text-obsidian-950';
                else if (langKey === 'bn') document.body.className = 'font-bengali selection:bg-gold-500 selection:text-obsidian-950';
                else document.body.className = 'font-sans selection:bg-gold-500 selection:text-obsidian-950';
            }
        }
